{
  "name": "ai-webmap",
  "version": "0.1.0",
  "type": "module",
  "blocksTemplate": "default",
  "description": "Chat-driven thematic map demo (AWS Blocks backend, SvelteKit SPA)",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "aws-blocks"
  ],
  "scripts": {
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "spec": "blocks-generate-spec",
    "dev:server": "tsx watch aws-blocks/scripts/server.ts",
    "dev": "tsx watch aws-blocks/scripts/server.ts",
    "dev:stop": "tsx aws-blocks/scripts/stop.ts",
    "sandbox": "tsx aws-blocks/scripts/sandbox.ts",
    "sandbox:deploy": "tsx aws-blocks/scripts/sandbox.ts --deploy-only",
    "sandbox:preview": "tsx aws-blocks/scripts/sandbox.ts --preview",
    "sandbox:destroy": "tsx -C cdk aws-blocks/scripts/sandbox-destroy.ts",
    "sandbox:console": "tsx aws-blocks/scripts/console.ts",
    "cleanup": "tsx aws-blocks/scripts/cleanup.ts",
    "prebuild": "blocks-generate-client",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "tsx aws-blocks/scripts/deploy.ts",
    "secret": "tsx aws-blocks/scripts/secret.ts",
    "typegen": "tsx aws-blocks/scripts/typegen.ts",
    "destroy": "tsx aws-blocks/scripts/destroy.ts",
    "seed:users": "tsx scripts/seed/seed-users.ts",
    "admin:create-user": "tsx scripts/admin/create-user.ts",
    "data:convert": "tsx scripts/data/convert.ts",
    "data:catalog": "tsx scripts/data/catalog.ts",
    "data:upload": "tsx -C browser scripts/data/upload.ts",
    "test:e2e": "tsx -C browser test/e2e.test.ts",
    "vendorize": "blocks-vendorize",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-blocks/bb-agent": "^0.7.0",
    "@aws-blocks/blocks": "*",
    "@aws-blocks/hosting": "*",
    "@duckdb/duckdb-wasm": "1.32.0",
    "maplibre-gl": "6.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-blocks/bb-auth-basic": "^0.2.0",
    "@aws-sdk/client-dynamodb": "^3.1170.0",
    "@duckdb/node-api": "1.4.3-r.3",
    "@sveltejs/adapter-static": "^3.0.11",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.12",
    "aws-cdk": "^2.1145.0",
    "aws-cdk-lib": "^2.273.0",
    "bcryptjs": "^3.0.3",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "mapshaper": "0.8.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-maplibre-gl": "^2.2.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "blocksTemplateVersion": "0.1.0"
}
