# Copy to .env (git-ignored) and set a password of at least 8 characters for each user.
# Quote values that contain `#` or spaces: an unquoted `#` starts a comment and drops the rest.
# Used by `npm run seed:users` and `npm run test:e2e`. The three user names must differ.
# admin: on the allowed list and the admin list (also the upload user)
SEED_USERNAME=seed-admin
SEED_PASSWORD=
# allowed: on the allowed list only
SEED_ALLOWED_USERNAME=seed-allowed
SEED_ALLOWED_PASSWORD=
# denied: on neither list (can sign in, is refused by every API method)
SEED_DENIED_USERNAME=seed-denied
SEED_DENIED_PASSWORD=
